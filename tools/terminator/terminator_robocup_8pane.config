[global_config]
  title_transmit_bg_color = "#26a269"
  suppress_multiple_term_dialog = True
[keybindings]
[profiles]
  [[default]]
    background_darkness = 0.85
    background_type = transparent
    cursor_color = "#aaaaaa"
    scrollback_infinite = True
    show_titlebar = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
  [[robocup]]
    [[[window0]]]
      type = Window
      parent = ""
      title = RoboCup ROS2
      maximised = True
    [[[main_split]]]
      type = VPaned
      parent = window0
      order = 0
      ratio = 0.5
    [[[top_split_1]]]
      type = HPaned
      parent = main_split
      order = 0
      ratio = 0.75
    [[[top_split_2]]]
      type = HPaned
      parent = top_split_1
      order = 0
      ratio = 0.6666666667
    [[[top_split_3]]]
      type = HPaned
      parent = top_split_2
      order = 0
      ratio = 0.5
    [[[term1_nav]]]
      type = Terminal
      parent = top_split_3
      order = 0
      title = 1 robocup_navigator
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run robocup_navigator robocup_navigator" "nav"'
    [[[term2_arm]]]
      type = Terminal
      parent = top_split_3
      order = 1
      title = 2 arm (vision+gripper+cargo+robot)
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 launch amr_robot_launch amr_robot.launch.py" "arm"'
    [[[term3_mock_wb]]]
      type = Terminal
      parent = top_split_2
      order = 1
      title = 3 mock_wb
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run sml_system_pkg mock_wb_node --ros-args -p delay_sec:=5.0" "mock_wb"'
    [[[term4_sml_planning]]]
      type = Terminal
      parent = top_split_1
      order = 1
      title = 4 sml_planning
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run sml_system_pkg sml_planning_node --ros-args -p side:=a" "sml_planning"'
    [[[bottom_split_1]]]
      type = HPaned
      parent = main_split
      order = 1
      ratio = 0.6666666667
    [[[bottom_split_2]]]
      type = HPaned
      parent = bottom_split_1
      order = 0
      ratio = 0.5
    [[[term5_sml_manager]]]
      type = Terminal
      parent = bottom_split_2
      order = 0
      title = 5 sml_manager
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run sml_system_pkg sml_manager_node --ros-args -p side:=a" "sml_manager"'
    [[[term6_order_server]]]
      type = Terminal
      parent = bottom_split_2
      order = 1
      title = 6 order_server
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run sml_system_pkg order_server" "order_server"'
    [[[term7_debug]]]
      type = Terminal
      parent = bottom_split_1
      order = 1
      title = 7 debug
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "" "debug"'
[plugins]
