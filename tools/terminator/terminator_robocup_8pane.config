[global_config]
  title_transmit_bg_color = "#26a269"
  suppress_multiple_term_dialog = True
[keybindings]
[profiles]
  [[default]]
    background_darkness = 0.85
    background_type = transparent
    cursor_color = "#aaaaaa"
    scrollback_infinite = True
    show_titlebar = True
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
  [[robocup]]
    [[[window0]]]
      type = Window
      parent = ""
      title = RoboCup ROS2 8 Pane
      maximised = True
    [[[main_split]]]
      type = VPaned
      parent = window0
      order = 0
      ratio = 0.5
    [[[top_split_1]]]
      type = HPaned
      parent = main_split
      order = 0
      ratio = 0.75
    [[[top_split_2]]]
      type = HPaned
      parent = top_split_1
      order = 0
      ratio = 0.6666666667
    [[[top_split_3]]]
      type = HPaned
      parent = top_split_2
      order = 0
      ratio = 0.5
    [[[term1_all_in_one]]]
      type = Terminal
      parent = top_split_3
      order = 0
      title = 1 all_in_one
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 launch all_in_one_package all_in_one_launch.py" "all_in_one"'
    [[[term2_navigator]]]
      type = Terminal
      parent = top_split_3
      order = 1
      title = 2 navigator
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run robocup_navigator robocup_navigator --ros-args -p side_mode:=A" "navigator"'
    [[[term3_robot_launch]]]
      type = Terminal
      parent = top_split_2
      order = 1
      title = 3 robot_launch
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 launch amr_robot_launch amr_robot.launch.py vision_visualize:=true" "robot_launch"'
    [[[term4_mock_wb]]]
      type = Terminal
      parent = top_split_1
      order = 1
      title = 4 mock_wb
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run sml_system_pkg mock_wb_node" "mock_wb"'
    [[[bottom_split_1]]]
      type = HPaned
      parent = main_split
      order = 1
      ratio = 0.75
    [[[bottom_split_2]]]
      type = HPaned
      parent = bottom_split_1
      order = 0
      ratio = 0.6666666667
    [[[bottom_split_3]]]
      type = HPaned
      parent = bottom_split_2
      order = 0
      ratio = 0.5
    [[[term5_planning]]]
      type = Terminal
      parent = bottom_split_3
      order = 0
      title = 5 planning
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run sml_system_pkg sml_planning_node --ros-args -p side:=a" "planning"'
    [[[term6_manager]]]
      type = Terminal
      parent = bottom_split_3
      order = 1
      title = 6 manager
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run sml_system_pkg sml_manager_node --ros-args -p side:=a" "manager"'
    [[[term7_order_server]]]
      type = Terminal
      parent = bottom_split_2
      order = 1
      title = 7 order_server
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 run sml_system_pkg order_server" "order_server"'
    [[[term8_debug]]]
      type = Terminal
      parent = bottom_split_1
      order = 1
      title = 8 debug
      command = bash -lc '"__ROS2_WS__"/tools/terminator/ros2_preset_prompt.sh "ros2 topic list" "debug"'
[plugins]
